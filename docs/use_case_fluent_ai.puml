@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7F5FF
  BorderColor #5B4BC4
  ArrowColor #555555
}

actor "Pengguna" as User

rectangle "Sistem Fluent AI" {
  usecase "Register" as UC_Register
  usecase "Memverifikasi Email" as UC_Verify
  usecase "Login" as UC_Login
  usecase "Lupa Password" as UC_Reset

  usecase "Melakukan Latihan\nWawancara" as UC_Practice
  usecase "Mendapat Evaluasi\nWawancara" as UC_Feedback

  usecase "Menganalisis CV" as UC_CV
  usecase "Mengunggah dan\nMengekstrak PDF CV" as UC_Upload
  usecase "Mendapat Rekomendasi\nPekerjaan" as UC_Recommend

  usecase "Menonton Video\nPanduan Wawancara" as UC_Video
  usecase "Mengelola Jadwal\nWawancara" as UC_Schedule
  usecase "Menerima Pengingat\nJadwal" as UC_Reminder
  usecase "Melihat Riwayat dan\nProgres Latihan" as UC_Progress
  usecase "Melihat Peringkat" as UC_Rank
  usecase "Mengelola Profil" as UC_Profile
  usecase "Keluar dari Aplikasi" as UC_Logout
}

User -- UC_Register
User -- UC_Login
User -- UC_Reset
User -- UC_Practice
User -- UC_CV
User -- UC_Video
User -- UC_Schedule
User -- UC_Progress
User -- UC_Rank
User -- UC_Profile
User -- UC_Logout

UC_Register ..> UC_Verify : <<include>>
UC_Practice ..> UC_Feedback : <<include>>
UC_CV ..> UC_Upload : <<include>>
UC_CV ..> UC_Recommend : <<include>>
UC_Schedule ..> UC_Reminder : <<include>>
@enduml
